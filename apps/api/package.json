{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "oxfmt \"src/**/*.ts\"",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@nestjs/authentication": "^0.1.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-node": "^12.3.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^18.0.8",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.4.2",
    "prisma": "7",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsrs": "^0.20.0-ts7.1.0-beta",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
