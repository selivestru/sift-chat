{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "import",
    "jsx-a11y",
    "promise",
    "react-perf",
    "unicorn",
    "vitest"
  ],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["off"],
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  },
  "ignorePatterns": ["src/app/routeTree.gen.ts"]
}
